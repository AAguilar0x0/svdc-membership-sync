# Read-only MySQL connection to the Open Dental database.
# On the practice laptop this is the on-prem OD VM, reachable over the VPN.
# Everything that reads — the matcher, the plan check, and the write phase's
# before/after verification — goes through this, and every statement is a SELECT.
OD_DB_URL=mysql://readonly_user:password@10.30.10.10:3306/opendental

# ── Write phase only (`pnpm apply --apply`) ──────────────────────────────────
# Nothing below is needed to match, report, or dry-run. The only writes this
# project makes are `discountplansub` rows, over the REST API, and never a DELETE.
#
# Point this at the local stub first (`pnpm fake-od-api`), not at the practice:
#   OD_API_URL=http://127.0.0.1:5179
OD_API_URL=
# `ODFHIR {DeveloperKey}/{CustomerKey}`. Supply the two keys, or one prebuilt token.
OD_DEVELOPER_KEY=
OD_CUSTOMER_KEY=
OD_API_TOKEN=
# Minimum gap between writes. OD Cloud rate-limits; a local API does not care.
OD_WRITE_RATE_LIMIT_MS=1000

# The local stub. FAKE_OD_REJECT_OVERLAP=1 makes it refuse a POST for a patient who
# already holds an active sub, which is the branch add-then-term has to survive.
FAKE_OD_PORT=5179
FAKE_OD_REJECT_OVERLAP=
